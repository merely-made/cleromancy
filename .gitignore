/target/
/target-*/
/.cargo/
# Curated textual receipts are tracked; generated stores, screenshots, and
# the byte-stability comparison copies stay local (headed plan evidence rule).
/receipts/*
!/receipts/*.html
!/receipts/*.json
!/receipts/*.scn
!/receipts/*.ps1
/receipts/*-second.*
/receipts/*-repeat.*
Cargo.lock
