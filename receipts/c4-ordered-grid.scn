advance
wait
assert snap product-busy == false
assert snap sessions == 3
assert snap readings == 3
assert snap reflections == 1
assert text What I must release
c4-reveal open-neighborhood
settle 2
c4-click open-neighborhood
wait
assert snap product-busy == false
assert snap ambient-families == 4
assert snap ambient-scene == grid.default
assert snap ambient-still == true
