# New public-seed shuffled draw using a saved custom layout and mounted UI actions.
wait
assert snap product-busy == false
c3-install
wait
assert snap product-busy == false
c2-author-layout
wait
assert snap product-busy == false
c5-read
wait
assert snap product-busy == false
assert snap readings == 3
assert snap shuffled == true
assert snap unique-cards == 3
