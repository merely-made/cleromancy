          "positions": [
            {
              "label": "Foundation",
              "meaning": "The ground you are starting from: what supports the situation, or what you are taking for granted.",
              "name": "foundation"
            },
            {
              "label": "Tension",
              "meaning": "Read against the foundation: what complicates it, challenges it, or asks for a different response.",
