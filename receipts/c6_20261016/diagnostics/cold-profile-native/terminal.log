          "positions": [
            {
              "label": "Foundation",
              "meaning": "The ground you are starting from: what supports the situation, or what you are taking for granted.",
              "name": "foundation"
            },
            {
              "label": "Tension",
              "meaning": "Read against the foundation: what complicates it, challenges it, or asks for a different response.",
              "name": "tension"
            },
            {
              "label": "Next step",
              "meaning": "A possible response to that tension: something to try or attend to, rather than a promised outcome.",
              "name": "next_step"
            },
            {
              "label": "Focus",
              "meaning": "A single lens on your question. Notice what fits your experience and what does not.",
              "name": "focus"
            }
          ],
